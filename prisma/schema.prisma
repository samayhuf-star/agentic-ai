generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  phone              String?     @unique
  email              String?     @unique
  compAccess         Boolean     @default(false)
  pendingEmail       String?
  businessName       String?
  sells              String?
  category           String?
  businessType       String?
  customType         String?
  goal               String?
  onboardedAt        DateTime?
  paused             Boolean     @default(false)
  welcomeEmailSentAt DateTime?
  marketingOptOut    Boolean     @default(false)
  emailTokenHash     String?     @unique
  emailTokenExpires  DateTime?
  pinHash            String?
  name               String?
  city               String?
  mktFirst           Json?
  mktLast            Json?
  channelFirst       String?
  channelLast        String?
  adminNotes         String?
  suspendedAt        DateTime?
  createdByAdmin     String?
  createdAt          DateTime    @default(now())
  payments           Payment[]
  agents             UserAgent[]
  approvals          Approval[]
  tasks              Task[]
  messages           Message[]
  sessions           Session[]
  aiKey              UserAiKey?

  @@index([createdAt])
  @@index([onboardedAt])
}

model Payment {
  id                  String     @id
  userId              String?
  user                User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  gateway             String
  amountInr           Int
  status              String
  isTest              Boolean    @default(false)
  phone               String?
  email               String?
  name                String?
  gatewayPaymentId    String?
  raw                 Json?
  smsSentAt           DateTime?
  createdAt           DateTime   @default(now())
  paidAt              DateTime?
  refundedAt          DateTime?
  refundedBy          String?
  method              String?
  reference           String?
  adminNote           String?
  createdBy           String?
  updatedAt           DateTime?  @updatedAt
  affiliateId         String?
  affiliate           Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  refClickId          String?
  refPostId           String?
  gatewayConfirmedAt  DateTime?
  gatewayConfirmedVia String?
  mktFirst            Json?
  mktLast             Json?
  channelFirst        String?
  channelLast         String?
  gclid               String?
  capiPurchaseAt      DateTime?
  userAgent           String?
  device              String?

  @@index([affiliateId])
  @@index([status])
  @@index([userId])
  @@index([status, isTest, paidAt])
  @@index([status, isTest, createdAt])
  @@index([isTest, createdAt])
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model RateLimit {
  id      String   @id
  count   Int
  resetAt DateTime
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  isAdmin   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Agent {
  id         String      @id
  name       String
  role       String
  department String
  blurb      String
  color      String
  goals      String
  sort       Int
  userAgents UserAgent[]
  approvals  Approval[]
  messages   Message[]
}

model UserAgent {
  id          String    @id @default(cuid())
  userId      String
  agentId     String
  enabled     Boolean   @default(false)
  recommended Boolean   @default(false)
  pinned      Boolean   @default(false)
  sortOrder   Int       @default(0)
  lastReadAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model Approval {
  id        String    @id @default(cuid())
  userId    String
  agentId   String
  title     String
  detail    String
  status    String
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  title     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  role      String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, agentId, createdAt])
  @@index([userId, role, createdAt])
}

model UserAiKey {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  model        String
  encryptedKey String
  iv           String
  authTag      String
  keyLast4     String
  isValid      Boolean   @default(false)
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider, createdAt])
}

model Setting {
  key   String @id
  value String
}

model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  body      String
  provider  String
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String
  provider  String
  createdAt DateTime @default(now())

  @@index([toEmail, createdAt])
}

model Lead {
  id              String         @id @default(cuid())
  orderId         String         @unique
  email           String?
  phone           String?
  name            String?
  amountInr       Int
  status          String
  marketingOptOut Boolean        @default(false)
  userId          String?
  createdAt       DateTime       @default(now())
  paidAt          DateTime?
  userAgent       String?
  device          String?
  followups       FollowupSend[]

  @@index([status, createdAt])
  @@index([email])
}

model FollowupSend {
  id        String   @id @default(cuid())
  key       String   @unique
  step      String
  toEmail   String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model AlertLog {
  id        String   @id @default(cuid())
  kind      String
  channel   String
  status    String
  dedupeKey String?
  toAddress String
  subject   String
  body      String
  error     String?
  createdAt DateTime @default(now())

  @@unique([dedupeKey, channel])
  @@index([createdAt])
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  summary    String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Affiliate {
  id              String                @id @default(cuid())
  name            String
  email           String?
  phone           String?
  handles         String?
  code            String                @unique
  token           String                @unique
  commissionType  String                @default("percent")
  rate            Float
  status          String                @default("active")
  payoutNotes     String?
  notes           String?
  city            String?
  instagramUrl    String?
  tiktokUrl       String?
  followers       Int?
  niche           String?
  pitch           String?
  source          String                @default("admin")
  appliedAt       DateTime?
  termsAcceptedAt DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  hiddenBlocks    String                @default("")
  payoutEnc       String?
  payoutMasked    String?
  payoutUpdatedAt DateTime?
  payoutUpdatedBy String?
  payoutCheckedAt DateTime?
  rejectReason    String?
  lastEmailKind   String?
  lastEmailStatus String?
  lastEmailAt     DateTime?
  lastEmailError  String?
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  clicks          AffiliateClick[]
  commissions     AffiliateCommission[]
  payments        Payment[]
  posts           AffiliatePost[]

  @@index([status])
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landingPath String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  ipHash      String?
  uaHash      String?
  postId      String?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@index([postId])
  @@index([affiliateId, ipHash, createdAt])
}

model AffiliateCommission {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  paymentId     String?
  key           String?   @unique
  kind          String
  amountInr     Int
  saleAmountInr Int?
  rateLabel     String?
  status        String
  note          String?
  voidReason    String?
  approvedAt    DateTime?
  approvedBy    String?
  paidAt        DateTime?
  paidBy        String?
  payoutRef     String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([affiliateId, status])
  @@index([paymentId])
}

model AffiliatePost {
  id               String    @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  platform         String
  url              String
  title            String?
  postedAt         DateTime?
  views            Int       @default(0)
  likes            Int       @default(0)
  comments         Int       @default(0)
  shares           Int       @default(0)
  metricsSource    String    @default("manual")
  metricsUpdatedAt DateTime?
  metricsUpdatedBy String?
  verified         Boolean   @default(false)
  verifiedBy       String?
  verifiedAt       DateTime?
  locked           Boolean   @default(false)
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([affiliateId, createdAt])
}

model MarketingVisit {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  source    String
  channel   String?
  campaign  String?
  mkt       Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([source, createdAt])
}

model SystemEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  source    String?
  email     String?
  phone     String?
  userId    String?
  paymentId String?
  amountInr Int?
  status    String?
  summary   String
  detail    String?
  tag       String?
  dedupeKey String?  @unique

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([email, createdAt])
  @@index([source, createdAt])
  @@index([paymentId, createdAt])
  @@index([userId, createdAt])
  @@index([tag, createdAt])
}
