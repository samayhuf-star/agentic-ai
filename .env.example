# Copy this file to .env. Leave a value blank to use the safe test mode for that service.
# Prices and the checkout path are read from here. Amounts are rupees (not paise).

# --- App ---
# Public address of this site. Used in SMS, WhatsApp and email links.
# Local test: http://localhost:3000
APP_URL=http://localhost:3000

# Secret used to hash one-time codes and session cookies. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string


# Optional. bcrypt hash of a 6-digit sign-in PIN for LOGIN_PIN_EMAIL.
# Only the hash belongs here or in the user's pinHash column — never the PIN itself.
# If set, that email sees a PIN field on /login, with an email-code fallback.
LOGIN_PIN_HASH=
LOGIN_PIN_EMAIL=

# Comma-separated owner emails. Matching is case-insensitive.
# These addresses can sign in with the email code even before a payment.
# The first sign-in opens a full account (no payment row) and /sup-admin.
ADMIN_EMAILS=you@adiology.io

# Comma-separated staff emails. Matching is case-insensitive.
# These addresses can sign in with the email code even before a payment.
# They can open /sup-admin and look at sales, orders, customers, the funnel, alerts and follow-ups.
# They cannot refund, switch the gateway, export a CSV, change settings, or mark test orders.
# If an email is also listed in ADMIN_EMAILS, that person is an admin.
STAFF_EMAILS=

# --- Price (shown on the home page; checkout always charges PRICE_INR) ---
PRICE_INR=1999
PRICE_USD=24
COMPARE_PRICE_INR=4999
COMPARE_PRICE_USD=60
# Launch price countdown. India time.
LAUNCH_OFFER_ENDS=2026-12-31T23:59:59+05:30

# Optional. If payment API keys are empty, Buy sends people here (a Cashfree payment form link).
# When API keys exist, AI Time Machine creates a real order and does not use this link.
CHECKOUT_URL=

# Which gateway to start on before anyone changes it in /sup-admin.
# cashfree | razorpay | payu
PAYMENT_GATEWAY=cashfree

# --- Database (Postgres) ---
# On Railway, the Postgres plugin sets DATABASE_URL for you. Do not paste a local URL there.
# Local test: leave this as-is. `npm run dev` starts a temporary database on this computer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&pgbouncer=true

# --- Cashfree (main payment gateway) ---
# Dashboard: https://merchant.cashfree.com
# Webhook URL to paste there: https://YOURDOMAIN/api/webhooks/cashfree
# Use sandbox until you are ready for real money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# TEST uses the Cashfree sandbox. PROD uses live payments.
CASHFREE_ENV=TEST

# --- Razorpay (backup) ---
# Webhook URL: https://YOURDOMAIN/api/webhooks/razorpay
# Event: payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PayU (backup) ---
# Webhook / success URL is set by the app. Paste the merchant key and salt from PayU.
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_ENV=test

# Shared secret for test payments only. Ignored once a real gateway secret is set.
MOCK_WEBHOOK_SECRET=dev-only-mock-secret

# --- SMS / WhatsApp (the link sent after payment) ---
# msg91 | gupshup | mock
# mock prints the message in the terminal. No text is sent.
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=

# --- Email (one-time codes and the welcome note) ---
# https://resend.com — leave blank locally. The code is shown on screen and in the terminal.
RESEND_API_KEY=
# Sender Resend has verified. Replies go to support@theaitimemachine.com.
RESEND_FROM=AI Time Machine <no-reply@adiology.io>

# Razorpay backup payment link, used only in recovery emails (never on checkout).
RAZORPAY_BACKUP_URL=https://rzp.io/rzp/THEAITIMEMACHINE

# Owner alerts. Comma-separated. Leave blank to skip email alerts.
OWNER_ALERT_EMAILS=
# WhatsApp: none, callmebot, or meta.
WHATSAPP_PROVIDER=none
OWNER_WHATSAPP_NUMBER=
CALLMEBOT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Secret for POST /api/jobs/followups. The cron service sends it as x-cron-secret.
CRON_SECRET=

# Locks buyer AI keys at rest. 64 hex characters, base64 for 32 bytes, or any other string.
# Leave blank and saving a key fails with a plain message. Keys are never stored in the clear.
ENCRYPTION_KEY=

# --- Optional platform key, used only when a buyer has not connected their own ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-sol

# --- Marketing / ads (optional) ---
# Public GA4 measurement id, e.g. G-XXXXXXXX. Leave blank until a GA4 property exists.
NEXT_PUBLIC_GA4_ID=
# Public Google Ads tag is already hardcoded as a fallback. Override only if the account changes.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Server-side Google Ads purchase upload (ConversionUploadService). All four credentials are required.
# If these are missing, the browser tag still fires on the success page, but UPI buyers who do not return are not counted.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional. Defaults to the AI Time Machine account and the Purchase (paid) action.
GOOGLE_ADS_CUSTOMER_ID=9099283797
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1870645876
GOOGLE_ADS_CONVERSION_ACTION_ID=7918381917
# Set to on only if Google Ads customer data terms for enhanced conversions are accepted.
GOOGLE_ADS_ENHANCED_CONVERSIONS=

# Payment recovery emails. on = send the unpaid-order sequence to buyers.
RECOVERY_EMAILS=
