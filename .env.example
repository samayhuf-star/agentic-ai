# Copy this file to .env. Leave a value blank to use the safe test mode for that service.
# Prices and the checkout path are read from here. Amounts are rupees (not paise).

# --- App ---
# Public address of this site. Used in SMS, WhatsApp and email links.
# Local test: http://localhost:3000
APP_URL=http://localhost:3000

# Secret used to hash one-time codes and session cookies. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Comma-separated owner emails. Matching is case-insensitive.
# These addresses can sign in with the email code even before a payment.
# The first sign-in opens a full account (no payment row) and /sup-admin.
ADMIN_EMAILS=you@adiology.io

# --- Price (shown on the home page; checkout always charges PRICE_INR) ---
PRICE_INR=1999
PRICE_USD=24
COMPARE_PRICE_INR=4999
COMPARE_PRICE_USD=60
# Launch price countdown. India time.
LAUNCH_OFFER_ENDS=2026-12-31T23:59:59+05:30

# Optional. If payment API keys are empty, Buy sends people here (a Cashfree payment form link).
# When API keys exist, AI Time Machine creates a real order and does not use this link.
CHECKOUT_URL=

# Which gateway to start on before anyone changes it in /sup-admin.
# cashfree | razorpay | payu
PAYMENT_GATEWAY=cashfree

# --- Database (Postgres) ---
# On Railway, the Postgres plugin sets DATABASE_URL for you. Do not paste a local URL there.
# Local test: leave this as-is. `npm run dev` starts a temporary database on this computer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&pgbouncer=true

# --- Cashfree (main payment gateway) ---
# Dashboard: https://merchant.cashfree.com
# Webhook URL to paste there: https://YOURDOMAIN/api/webhooks/cashfree
# Use sandbox until you are ready for real money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# TEST uses the Cashfree sandbox. PROD uses live payments.
CASHFREE_ENV=TEST

# --- Razorpay (backup) ---
# Webhook URL: https://YOURDOMAIN/api/webhooks/razorpay
# Event: payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PayU (backup) ---
# Webhook / success URL is set by the app. Paste the merchant key and salt from PayU.
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_ENV=test

# Shared secret for test payments only. Ignored once a real gateway secret is set.
MOCK_WEBHOOK_SECRET=dev-only-mock-secret

# --- SMS / WhatsApp (the link sent after payment) ---
# msg91 | gupshup | mock
# mock prints the message in the terminal. No text is sent.
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=

# --- Email (one-time codes and the welcome note) ---
# https://resend.com — leave blank locally. The code is shown on screen and in the terminal.
RESEND_API_KEY=
# Sender Resend has verified. Replies go to support@theaitimemachine.com.
RESEND_FROM=AI Time Machine <no-reply@adiology.io>

# --- Optional: a real language model for Talk to an agent ---
# Leave blank and agents reply with built-in demo answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
